# Database connection URL
# SQLite (default for development):
DATABASE_URL=sqlite:///./supplier_invoices.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/supplier_invoices

# Tax rate applied to all invoices (decimal, e.g. 0.08 = 8%)
TAX_RATE=0.08

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Set to true to enable auto-reload during development
DEBUG=false

# CORS — comma-separated allowed origins, or * for all
CORS_ORIGINS=*
